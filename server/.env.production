# Production Environment Configuration
# IMPORTANT: Change all default values before deploying!

# Server Configuration
PORT=5000
NODE_ENV=production

# Database - UPDATE WITH YOUR MONGODB ATLAS CONNECTION STRING
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/calendar-app?retryWrites=true&w=majority

# JWT Configuration - GENERATE A STRONG SECRET IN PRODUCTION
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_FOR_PRODUCTION_USE_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN=7d

# Client URL - UPDATE WITH YOUR DEPLOYED FRONTEND URL
CLIENT_URL=https://your-app.vercel.app

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-production-email@gmail.com
EMAIL_PASS=your-app-password

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Rate Limiting (production settings)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Security
TRUST_PROXY=true
SECURE_COOKIES=true

# Logging
LOG_LEVEL=info